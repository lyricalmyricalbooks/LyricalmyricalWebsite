{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.log"],
      "runtime": "nodejs22"
    }
  ],
  "hosting": {
    "site": "lyricalmyrical-web-v2",
    "public": "dist",
    "ignore": [],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {"source": "/product/the-hound-ian-willms", "destination": "/books/the-hound", "type": 301},
      {"source": "/product/Lyricalmyricalcollections", "destination": "/books/lyricalmyrical-collections-1-collective-photobook", "type": 301},
      {"source": "/product/lyricalmyricalcollections", "destination": "/books/lyricalmyrical-collections-1-collective-photobook", "type": 301},
      {"source": "/product/un-fantastico-altrove-silvia-clo-di-gregorio", "destination": "/books/un-fantastico-altrove", "type": 301},
      {"source": "/product/Archaeology_of_Presence", "destination": "/books/archaeology-of-presence", "type": 301},
      {"source": "/product/archaeology_of_presence", "destination": "/books/archaeology-of-presence", "type": 301},
      {"source": "/product/sistema_non_autorizzato", "destination": "/books/sistema-non-autorizzato", "type": 301},
      {"source": "/product/injured", "destination": "/books/injured-zine", "type": 301},
      {"source": "/product/oltre-il-tempo-isabella-tortola", "destination": "/books/oltre-il-tempo", "type": 301},
      {"source": "/product/cream-show", "destination": "/books/cream-show", "type": 301},
      {"source": "/product/content-unaware", "destination": "/books/content-unaware", "type": 301},
      {"source": "/products", "destination": "/collections/publications", "type": 301},
      {"source": "/category/books", "destination": "/collections/books", "type": 301},
      {"source": "/category/zines", "destination": "/collections/zines", "type": 301},
      {"source": "/about", "destination": "/page/about", "type": 301},
      {"source": "/contact", "destination": "/page/contact", "type": 301},
      {"source": "/submissions", "destination": "/page/submissions", "type": 301},
      {"source": "/open-call-collective-book", "destination": "/page/open-call", "type": 301},
      {"source": "/roots", "destination": "/page/history-of-lyricalmyrical", "type": 301},
      {"source": "/product/**", "destination": "/collections/publications", "type": 301},
      {"source": "/category/**", "destination": "/collections/publications", "type": 301},
      {"source": "/cart", "destination": "/", "type": 301}
    ],
    "rewrites": [
      {
        "regex": "^/(?:(?:books|collections|page)/[^/]+/?|(?:account|admin)(?:/.*)?|checkout|track|wishlist)$",
        "destination": "/spa.html"
      }
    ],
    "headers": [
      {
        "regex": "^/assets/.+$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "regex": "^/(?:|spa|404|(?:books|collections|page)/.*|(?:account|admin)(?:/.*)?|checkout|track|wishlist|[^/]+\\.(?:xml|txt)|.*\\.html)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^/(?:spa|404)(?:\\.html)?$",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "regex": "^/.*$",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ]
      }
    ]
  }
}
